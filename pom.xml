<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.klsjnh</groupId>
    <artifactId>java17-lowcode011</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>java17-lowcode011-domain</module>
        <module>java17-lowcode011-application</module>
        <module>java17-lowcode011-infrastructure</module>
        <module>java17-lowcode011-web</module>
        <module>java17-lowcode011-app011</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.4.5</spring-boot.version>
        <framework.version>1.0.0</framework.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-common011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-domain011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-application011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-infrastructure011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-web011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-app011</artifactId>
                <version>${framework.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-lowcode011-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-lowcode011-application</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
